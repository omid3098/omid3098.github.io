---
import Base from '../layouts/Base.astro';

interface Entry {
  name: string;
  href?: string;                          // links the name
  role: string;
  link?: { text: string; href: string };  // links a phrase inside the role
  years: string;
}

interface Chapter {
  place: string;
  years: string;
  from: number;         // fractional years, for the graph
  to: number | null;    // null = still here
  note?: string;
  entries: Entry[];
}

interface Lane {
  label: string;
  years: string;
  from: number;
  to: number | null;    // null = ongoing
}

const chapters: Chapter[] = [
  {
    place: 'Iran', years: '2007–2021', from: 2007, to: 2021.8,
    note: 'I studied computer graphics at Karaj Islamic Azad University, 2006–2010.',
    entries: [
      { name: 'FSR Company', role: '3D character and environment artist', years: '2007–2013' },
      { name: 'Shexel', role: '3D generalist and game programmer', years: '2012–2015' },
      { name: 'Bitbyterz', role: 'game programmer and tool developer on Memoranda', link: { text: 'Memoranda', href: '/writing/memoranda' }, years: '2014–2015' },
      { name: 'Electro Gryphon Games', role: 'senior game programmer', years: '2015–2017' },
      { name: 'Pooyegaam', role: 'game programmer', years: '2017–2018' },
      { name: 'Cultural Infusion', role: 'freelance game programmer', years: '2018–2019' },
      { name: 'Garaj Games', role: 'gameplay programmer', years: '2019–2020' },
      { name: 'Arsam Robotics', role: 'lead game programmer, part-time', years: '2020–2021' },
      { name: 'Cafe Bazaar', role: 'technical artist', years: '2020–2021' },
    ],
  },
  {
    place: 'Turkey', years: '2021–2023', from: 2021.8, to: 2023.95,
    entries: [
      { name: 'LeMoonade', role: 'lead programmer and technical artist on CryptoRoomZ', link: { text: 'CryptoRoomZ', href: '/writing/cryptoroomz' }, years: '2021–2022' },
      { name: 'Gameloft Toronto', role: 'freelance technical artist, remote', years: '2022–2023' },
      { name: 'QuVery', href: '/writing/quvery', role: 'my own open-source asset validator', years: '2023' },
    ],
  },
  {
    place: 'Germany', years: '2024–now', from: 2023.95, to: null,
    entries: [
      { name: 'Ubisoft Blue Byte', role: 'senior technical artist', years: '2024–now' },
    ],
  },
];

// The disciplines overlap on purpose: each gets its own lane
const lanes: Lane[] = [
  { label: '3D art', years: '2007–2015', from: 2007, to: 2015 },
  { label: 'Programming', years: '2012–2022', from: 2012, to: 2022.5 },
  { label: 'Technical art', years: '2020–now', from: 2020.7, to: null },
  { label: 'AI systems', years: '2023–now', from: 2023, to: null },
];

// The graph runs from 2007 to the build date, as a fractional year
const START = 2007;
const today = new Date();
const NOW = today.getFullYear() + (today.getTime() - new Date(today.getFullYear(), 0, 1).getTime()) / (365.25 * 86400000);

const pos = (year: number) => +(((year - START) / (NOW - START)) * 100).toFixed(2);
const span = (from: number, to: number | null) => {
  const left = pos(from);
  return `left: ${left}%; width: ${+(pos(to ?? NOW) - left).toFixed(2)}%;`;
};

const ticks = [2007, 2010, 2015, 2020, 2025];
// Faint vertical year lines, painted as the background of every track
const grid = ticks
  .map((year) => `linear-gradient(var(--border), var(--border)) ${pos(year)}% 0 / 1px 100% no-repeat`)
  .join(', ');

const summary = `Disciplines, which overlap: ${lanes.map((lane) => `${lane.label} ${lane.years}`).join(', ')}. Places: ${chapters.map((chapter) => `${chapter.place} ${chapter.years}`).join(', ')}.`;
---

<Base
  title="Career"
  description="Where Omid Saadat has worked, from 3D art and game programming to technical art."
  activePage="career"
>
  <div class="page-header">
    <h1 class="page-title">Career</h1>
    <p class="page-description">Where I've worked. Roughly seven years of 3D art, seven of programming, and technical art for the rest. They overlap more than they follow each other.</p>
  </div>

  <section class="career-shape fade-in">
    <h2 class="section-label">the shape</h2>
    <div
      class="career-graph"
      style={`--grid: ${grid};`}
      role="img"
      aria-label="Timeline from 2007 to now: four disciplines that overlap, across three places."
    >
      {lanes.map((lane) => (
        <div class="career-lane">
          <span class="career-lane-label">{lane.label}</span>
          <div class="career-track">
            <div
              class={`career-bar${lane.to === null ? ' ongoing' : ''}`}
              style={span(lane.from, lane.to)}
              title={`${lane.label}, ${lane.years}`}
            ></div>
          </div>
        </div>
      ))}

      <div class="career-lane career-lane-places">
        <span class="career-lane-label">Places</span>
        <div class="career-places">
          <div class="career-strip">
            {chapters.map((chapter) => (
              <div class="career-place" style={span(chapter.from, chapter.to)} title={`${chapter.place}, ${chapter.years}`}>
                <span>{chapter.place}</span>
              </div>
            ))}
          </div>
          <ul class="career-legend">
            {chapters.map((chapter) => (
              <li><i></i>{chapter.place} {chapter.years}</li>
            ))}
          </ul>
        </div>
      </div>

      <div class="career-axis">
        <div class="career-ticks">
          {ticks.map((year) => (
            <span class="career-tick" style={`left: ${pos(year)}%;`}>{year}</span>
          ))}
          <span class="career-tick now" style="left: 100%;">now</span>
        </div>
      </div>
    </div>
    <p class="sr-only">{summary}</p>
  </section>

  <div class="career-chapters fade-in">
    {chapters.map((chapter) => (
      <section class="career-chapter">
        <h2 class="career-chapter-title">{chapter.place} <span class="career-chapter-years">{chapter.years}</span></h2>
        <ul class="career-list">
          {chapter.entries.map((entry) => {
            const [before, after] = entry.link ? entry.role.split(entry.link.text) : [entry.role, ''];
            return (
              <li class="career-entry">
                <span class="career-name">{entry.href ? <a href={entry.href}>{entry.name}</a> : entry.name}</span>
                <span class="career-role">
                  {entry.link ? <>{before}<a href={entry.link.href}>{entry.link.text}</a>{after}</> : entry.role}
                </span>
                <span class="career-entry-years">{entry.years}</span>
              </li>
            );
          })}
        </ul>
        {chapter.note && <p class="career-note">{chapter.note}</p>}
      </section>
    ))}
  </div>
</Base>
