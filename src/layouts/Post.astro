---
import Base from './Base.astro';

interface Props {
  frontmatter: {
    title: string;
    date: Date;
    description?: string;
    image?: string;
    tags?: string[];
    lang?: string;
    dir?: string;
    mermaid?: boolean;
    translation?: string;
    hero?: {
      tagline: string;
      sub?: string;
      icon?: string;
      clip?: string;
      clipAlt?: string;
      clipWidth?: number;
      clipHeight?: number;
      prompt?: string;
      links?: { label: string; href: string; primary?: boolean }[];
    };
  };
  slug?: string;
}

const { frontmatter, slug } = Astro.props;
const lang = frontmatter.lang || 'en';
const dir = frontmatter.dir || 'ltr';
const dateStr = frontmatter.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={frontmatter.title} description={frontmatter.description} image={frontmatter.image} publishedDate={frontmatter.date} tags={frontmatter.tags} lang={lang} dir={dir} activePage="writing" type="article">
  <article class={[dir === 'rtl' ? 'rtl' : '', frontmatter.hero ? 'product' : ''].join(' ').trim() || undefined}>
    {frontmatter.hero ? (
    <header class="product-hero fade-in">
      <div class="product-hero-top">
        <div>
          <p class="product-name">
            {frontmatter.hero.icon && <img src={frontmatter.hero.icon} alt="" width="40" height="40" />}
            <span transition:name={slug ? `title-${slug}` : undefined}>{frontmatter.title}</span>
          </p>
          <h1 class="product-tagline" set:html={frontmatter.hero.tagline} />
          {frontmatter.hero.sub && <p class="product-sub">{frontmatter.hero.sub}</p>}
        </div>
        <div class="product-links">
          {frontmatter.hero.links?.map(link => (
            <a class={link.primary ? 'product-btn primary' : 'product-btn'} href={link.href}>{link.label}</a>
          ))}
        </div>
      </div>
      {frontmatter.hero.clip && (
        <div class="product-frame product-clip">
          <img src={frontmatter.hero.clip} alt={frontmatter.hero.clipAlt || ''} width={frontmatter.hero.clipWidth} height={frontmatter.hero.clipHeight} />
        </div>
      )}
    </header>
    ) : (
    <header class="page-header">
      <h1 class="page-title" transition:name={slug ? `title-${slug}` : undefined}>{frontmatter.title}</h1>
      <div class="post-meta">
        {frontmatter.translation && (
          lang === 'fa'
            ? <a class="lang-switch" href={`/writing/${frontmatter.translation}/`} hreflang="en" lang="en" dir="ltr">English</a>
            : <a class="lang-switch" href={`/writing/${frontmatter.translation}/`} hreflang="fa" lang="fa" dir="rtl">فارسی</a>
        )}
        <time>{dateStr}</time>
        {frontmatter.tags && frontmatter.tags.length > 0 && (
          <span class="post-tags">
            {frontmatter.tags.slice(0, 4).map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </span>
        )}
      </div>
    </header>
    )}
    <div class={frontmatter.hero ? 'product-body' : 'prose'}>
      <slot />
    </div>
    {frontmatter.hero?.prompt && (
    <section id="install" class="product-install">
      <h2>Install it <em>with your agent</em>.</h2>
      <p>Paste this into Claude Code, Codex or another coding agent on Windows 11. It takes under a minute.</p>
      <div class="product-prompt">
        <button type="button" class="product-btn primary" data-copy={frontmatter.hero.prompt.trim()}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <span class="copy-label">Copy the prompt</span>
        </button>
        <pre>{frontmatter.hero.prompt.trim()}</pre>
      </div>
    </section>
    )}
  </article>

  <script is:inline data-astro-rerun>
    // An embedded X post (<blockquote class="twitter-tweet">) is drawn by X's script. Run it on every page
    // load, also after in-site navigation, when the script is already there and would not scan the new page.
    if (document.querySelector('.prose blockquote.twitter-tweet')) {
      if (window.twttr && window.twttr.widgets) window.twttr.widgets.load(document.querySelector('.prose'));
      else if (!document.querySelector('script[src*="platform.twitter.com/widgets.js"]')) {
        const s = document.createElement('script');
        s.src = 'https://platform.twitter.com/widgets.js';
        s.async = true;
        document.head.appendChild(s);
      }
    }
  </script>

  <script>
    // A project post's copy button puts its text on the clipboard and says so for a moment.
    document.addEventListener('click', async (e) => {
      const btn = e.target instanceof Element ? e.target.closest<HTMLButtonElement>('button[data-copy]') : null;
      if (!btn) return;
      try { await navigator.clipboard.writeText(btn.dataset.copy || ''); } catch { return; }
      const label = btn.querySelector('.copy-label');
      const before = label?.textContent;
      btn.classList.add('copied');
      if (label) label.textContent = 'Copied';
      setTimeout(() => { btn.classList.remove('copied'); if (label) label.textContent = before ?? ''; }, 1500);
    });
  </script>

  <script>
    // Click a post picture to see it large; click again or press Esc to close.
    document.addEventListener('click', (e) => {
      const img = e.target instanceof HTMLImageElement ? e.target : null;
      if (!img || !img.closest('.prose, .product-body') || img.closest('a')) return;
      let dlg = document.querySelector<HTMLDialogElement>('dialog.img-zoom');
      if (!dlg) {
        dlg = document.createElement('dialog');
        dlg.className = 'img-zoom';
        dlg.append(document.createElement('img'));
        dlg.addEventListener('click', () => dlg!.close());
        document.body.append(dlg);
      }
      const big = dlg.querySelector('img')!;
      big.src = img.currentSrc || img.src;
      big.alt = img.alt;
      dlg.showModal();
    });
  </script>

  <script>
    // <div class="compare" data-video data-poster data-left data-right>: one video with two pictures side by side
    // (left half, right half), drawn on a canvas with a bar you drag to see one or the other.
    function initCompare(box: HTMLElement) {
      box.classList.add('ready');
      const W = 960, H = 540;
      const canvas = document.createElement('canvas');
      canvas.width = W; canvas.height = H;
      const ctx = canvas.getContext('2d')!;
      const video = document.createElement('video');
      Object.assign(video, { muted: true, loop: true, playsInline: true, preload: 'auto', src: box.dataset.video || '' });
      const line = document.createElement('div'); line.className = 'compare-line';
      const knob = document.createElement('div'); knob.className = 'compare-knob';
      knob.tabIndex = 0; knob.setAttribute('role', 'slider'); knob.setAttribute('aria-label', 'Compare');
      knob.textContent = '‹ ›';
      const left = document.createElement('span'); left.className = 'compare-label left'; left.textContent = box.dataset.left || '';
      const right = document.createElement('span'); right.className = 'compare-label right'; right.textContent = box.dataset.right || '';
      if (box.dataset.poster) box.style.backgroundImage = `url(${box.dataset.poster})`;
      video.className = 'compare-src';
      box.append(video, canvas, line, knob, left, right);

      let split = 0.5;
      const draw = () => {
        if (video.readyState < 2) return;
        ctx.drawImage(video, 0, 0, W, H, 0, 0, W, H);
        ctx.save(); ctx.beginPath(); ctx.rect(split * W, 0, W - split * W, H); ctx.clip();
        ctx.drawImage(video, W, 0, W, H, 0, 0, W, H);
        ctx.restore();
      };
      const place = () => {
        line.style.left = knob.style.left = `${split * 100}%`;
        knob.setAttribute('aria-valuenow', String(Math.round(split * 100)));
        draw();
      };
      const fromX = (x: number) => { const r = box.getBoundingClientRect(); split = Math.min(1, Math.max(0, (x - r.left) / r.width)); place(); };
      let dragging = false;
      box.addEventListener('pointerdown', (e) => { dragging = true; box.setPointerCapture(e.pointerId); fromX(e.clientX); });
      box.addEventListener('pointermove', (e) => { if (dragging) fromX(e.clientX); });
      box.addEventListener('pointerup', () => { dragging = false; });
      box.addEventListener('pointercancel', () => { dragging = false; });
      knob.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') { split = Math.min(1, Math.max(0, split + (e.key === 'ArrowLeft' ? -0.05 : 0.05))); place(); e.preventDefault(); }
      });

      const loop = () => { if (!box.isConnected) { video.pause(); video.removeAttribute('src'); video.load(); return; } draw(); requestAnimationFrame(loop); };
      video.addEventListener('loadeddata', () => { box.style.backgroundImage = ''; draw(); }, { once: true });
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      new IntersectionObserver(([en]) => { if (en.isIntersecting && !still) video.play().catch(() => {}); else video.pause(); }).observe(box);
      place();
      requestAnimationFrame(loop);
    }
    document.addEventListener('astro:page-load', () => {
      document.querySelectorAll<HTMLElement>('.prose .compare:not(.ready)').forEach(initCompare);
    });
  </script>

  {frontmatter.mermaid && (
    <script is:inline type="module" data-astro-rerun>
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
      // Astro/Shiki renders ```mermaid blocks as:
      //   <pre class="astro-code" data-language="mermaid"><code><span>...</span></code></pre>
      // Mermaid expects <pre class="mermaid"> with raw text — convert before init.
      document.querySelectorAll('pre[data-language="mermaid"]').forEach((pre) => {
        const code = pre.querySelector('code');
        if (code) {
          const text = code.textContent;
          pre.className = 'mermaid';
          pre.removeAttribute('style');
          pre.removeAttribute('data-language');
          pre.textContent = text;
        }
      });
      mermaid.initialize({
        startOnLoad: false,
        theme: 'dark',
        themeVariables: {
          primaryColor: '#232328',
          primaryTextColor: '#d2d2d2',
          primaryBorderColor: '#6cb4ee',
          lineColor: '#5a5a5a',
          secondaryColor: '#1b1b1e',
          tertiaryColor: '#161618',
        }
      });
      await mermaid.run();
    </script>
  )}
</Base>
